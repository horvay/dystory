{
  "name": "dystory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n convex,web,media,gate,stt,assistant,director -c blue,green,magenta,yellow,cyan,red,white \"bun run convex\" \"bun run web\" \"bun run media\" \"bun run gate\" \"bun run stt\" \"bun run assistant\" \"bun run director\"",
    "start": "concurrently -k -n convex,web,media,gate,stt,assistant,director -c blue,green,magenta,yellow,cyan,red,white \"bun run convex\" \"bun run serve\" \"bun run media\" \"bun run gate\" \"bun run stt\" \"bun run assistant\" \"bun run director\"",
    "convex": "convex dev --tail-logs disable",
    "web": "vite",
    "serve": "vite build && vite preview",
    "media": "bun media/server.ts",
    "gate": "bun gate/gate.ts",
    "stt": "bun stt/server.ts",
    "stt:setup": "bash stt/setup.sh",
    "assistant": "bun worker/script-assistant.ts",
    "director": "bun worker/director.ts",
    "typecheck": "tsc -p . --noEmit && tsc -p convex --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "@convex-dev/prosemirror-sync": "^0.2.6",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-character-count": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-typography": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "convex": "^1.46.0",
    "diff": "^9.0.0",
    "lucide-react": "^1.49.0",
    "marked": "^18.0.14",
    "prosemirror-collab": "1.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7",
    "wouter": "^3.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/diff": "^8.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "convex-test": "^0.0.62",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.5"
  }
}
